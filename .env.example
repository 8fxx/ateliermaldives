# Claude, which writes the training plans. Leave unset if you've run `ant auth login`.
ANTHROPIC_API_KEY=

# Stripe (https://dashboard.stripe.com/test/apikeys)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Recurring monthly Price ID for the "Atelier Pace" membership
STRIPE_MEMBERSHIP_PRICE_ID=price_...

# Public URL used for Stripe redirects
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Local dev only: treat every visitor as a paying member (unlocks the full AI plan without Stripe)
ATELIER_DEV_MEMBER=0
