# Claude, which writes the training plans. Leave unset if you've run `ant auth login`.
ANTHROPIC_API_KEY=

# Stripe (https://dashboard.stripe.com/test/apikeys)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Recurring monthly Price ID for the "Equatra Pace" membership
STRIPE_MEMBERSHIP_PRICE_ID=price_...

# Public URL used for Stripe redirects
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Local dev only: treat every visitor as a paying member (unlocks the full AI plan without Stripe)
EQUATRA_DEV_MEMBER=0

# Database (libSQL). Local dev uses a SQLite file; in production use a hosted libSQL/Turso URL + token.
DATABASE_URL=file:local.db
DATABASE_AUTH_TOKEN=

# Used once by `npm run db:seed` to create the first admin account
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Bank transfer details shown to customers on unpaid orders
BANK_NAME=Bank of Maldives
BANK_ACCOUNT_NAME=
BANK_ACCOUNT_NUMBER=
NEXT_PUBLIC_PICKUP_LOCATION=EQUATRA studio, Malé

# Shopify store for merch (leave empty to use the built-in /shop)
NEXT_PUBLIC_SHOP_URL=
